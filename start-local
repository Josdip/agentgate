#!/usr/bin/env bash
set -eu
cd "$(dirname "$0")"

if [ ! -x .venv/bin/python ]; then
  python3 -m venv .venv
fi
if ! .venv/bin/python -c 'import fastapi, uvicorn, pydantic' >/dev/null 2>&1; then
  .venv/bin/python -m pip install --disable-pip-version-check -r requirements-dev.lock
fi
exec .venv/bin/python -m agentgate --setup-sandbox --first-run-link --fresh-session "$@"
