# Export these settings in your shell before running python -m agentgate.
AGENTGATE_PROJECT=/absolute/path/to/isolated/project
AGENTGATE_SONAR_TOKEN_FILE=/absolute/path/to/private/sonar-token
AGENTGATE_REVIEWER_TOKEN_FILE=/absolute/path/to/private/reviewer-token
AGENTGATE_SONAR_PORT=5000
AGENTGATE_PORT=8001
AGENTGATE_DB=data/discovery.sqlite3
# AGENTGATE_SONAR_SOURCE defaults to ~/homelab/sonar.
AGENTGATE_MANAGED_SONAR_PORT=5002
