# The local launcher generates .env automatically. Do not use these placeholders.
AGENTGATE_AGENT_TOKEN=replace-me
AGENTGATE_REVIEWER_TOKEN=replace-me-too
AGENTGATE_DB=data/agentgate.db

# Optional direct integrations for the additional demo identities.
# Use unique random credentials of at least 24 characters; omit for dashboard-only demos.
# AGENTGATE_SALES_TOKEN=
# AGENTGATE_FINANCE_TOKEN=

# Local browser demo access; set 0 for manual reviewer authentication.
AGENTGATE_DEMO_MODE=1
